---
// CaseStudyCard.astro — Card linking to a case study

interface Props {
  title: string;
  description: string;
  role: string;
  tags: string[];
  href: string;
  coverImage?: string;
  coverColor?: string; // Tailwind gradient classes, e.g. "from-violet-600 to-rose-500"
  status: 'published' | 'coming-soon';
}

const {
  title,
  description,
  role,
  tags,
  href,
  coverImage,
  coverColor = 'from-brand-primary to-brand-accent',
  status,
} = Astro.props;

const isComingSoon = status === 'coming-soon';
---

<article class:list={[
  "group relative bg-white dark:bg-brand-background-dark rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300",
  isComingSoon ? "opacity-75" : "hover:-translate-y-1 cursor-pointer"
]}>
  <!-- Cover -->
  <a href={isComingSoon ? undefined : href} aria-disabled={isComingSoon} tabindex={isComingSoon ? -1 : 0}>
    <div class="relative h-48 overflow-hidden">
      {coverImage ? (
        <img
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class:list={["w-full h-full bg-gradient-to-br", coverColor, "flex items-center justify-center"]}>
          <img src="/n8-logo-solid-1.svg" alt="" class="h-16 w-auto opacity-20" aria-hidden="true" />
        </div>
      )}

      {isComingSoon && (
        <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
          <span class="bg-white/90 dark:bg-gray-900/90 text-gray-800 dark:text-white text-sm font-semibold px-4 py-1.5 rounded-full">
            Coming Soon
          </span>
        </div>
      )}
    </div>
  </a>

  <!-- Body -->
  <div class="p-6">
    <p class="text-xs font-semibold text-brand-accent dark:text-brand-accent uppercase tracking-widest mb-2">
      {role}
    </p>
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-brand-primary dark:group-hover:text-brand-primary-dark transition-colors">
      <a href={isComingSoon ? undefined : href} tabindex={isComingSoon ? -1 : 0}>
        {title}
      </a>
    </h3>
    <p class="text-gray-600 dark:text-brand-body-dark text-sm leading-relaxed mb-4">
      {description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-brand-body-dark text-xs px-3 py-1 rounded-full font-medium">
          {tag}
        </span>
      ))}
    </div>

    {!isComingSoon && (
      <a
        href={href}
        class="inline-flex items-center gap-1 mt-4 text-brand-primary dark:text-brand-primary-dark font-semibold text-sm hover:gap-2 transition-all duration-200"
      >
        View Case Study
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )}
  </div>
</article>

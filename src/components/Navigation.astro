---
// Navigation component - appears on every page
---

<nav id="main-nav" class="bg-transparent sticky top-0 z-50 transition-all duration-300 ease-in-out">
	<div class="container mx-auto px-4">
		<div class="flex items-center justify-between h-16">
			<!-- Logo/Brand -->
			<a href="/" class="nav-link flex items-center space-x-2 hover:opacity-80 transition-opacity" aria-label="Home">
				<img src="/n8-logo-solid-1.svg" alt="Portfolio" class="h-16 w-auto" />
			</a>

			<!-- Desktop Navigation Links -->
			<div class="hidden md:flex items-center space-x-8">
				<a href="/" class="nav-link text-gray-700 dark:text-brand-body-dark hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium">
					Home
				</a>
				<a href="/about" class="nav-link text-gray-700 dark:text-brand-body-dark hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium">
					About
				</a>
				<a href="/#work" class="nav-link text-gray-700 dark:text-brand-body-dark hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium">
					Work
				</a>
				<a href="/contact" class="nav-link text-gray-700 dark:text-brand-body-dark hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium">
					Contact
				</a>
			</div>

			<!-- Mobile Menu Button -->
			<button
				id="mobile-menu-button"
				class="nav-link md:hidden text-brand-primary dark:text-white hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors"
				aria-label="Toggle menu"
			>
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</div>

		<!-- Mobile Navigation Menu -->
		<div id="mobile-menu" class="hidden md:hidden pb-4">
			<div class="flex flex-col space-y-2 mt-2">
				<a href="/" class="nav-link text-brand-primary dark:text-white hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium py-2 px-4 rounded hover:bg-white/10 dark:hover:bg-gray-800/50">
					Home
				</a>
				<a href="/about" class="nav-link text-brand-primary dark:text-white hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium py-2 px-4 rounded hover:bg-white/10 dark:hover:bg-gray-800/50">
					About
				</a>
				<a href="/#work" class="nav-link text-brand-primary dark:text-white hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium py-2 px-4 rounded hover:bg-white/10 dark:hover:bg-gray-800/50">
					Work
				</a>
				<a href="/contact" class="nav-link text-brand-primary dark:text-white hover:text-brand-primary dark:hover:text-brand-primary-dark transition-colors font-medium py-2 px-4 rounded hover:bg-white/10 dark:hover:bg-gray-800/50">
					Contact
				</a>
			</div>
		</div>
	</div>
</nav>

<script>
	// Mobile menu toggle functionality
	const mobileMenuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');

	if (mobileMenuButton && mobileMenu) {
		mobileMenuButton.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});
	}

	// Scroll detection for navigation background
	const nav = document.getElementById('main-nav');

	function handleScroll() {
		if (!nav) return;

		const scrolled = window.scrollY > 20;

		if (scrolled) {
			nav.classList.add('bg-white', 'dark:bg-brand-background-dark', 'shadow-md');
		} else {
			nav.classList.remove('bg-white', 'dark:bg-brand-background-dark', 'shadow-md');
		}
	}

	handleScroll();
	window.addEventListener('scroll', handleScroll);
</script>

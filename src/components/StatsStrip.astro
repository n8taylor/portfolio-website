---
// StatsStrip.astro — Snapshot stats/descriptors below the hero

interface Stat {
  value: string;
  label: string;
}

const stats: Stat[] = [
  { value: "5+", label: "Years in UX/UI" },
  { value: "USU", label: "Utah State University" },
  { value: "Figma", label: "Primary Design Tool" },
  { value: "UX → Visual", label: "Full Design Spectrum" },
];
---

<section class="bg-white dark:bg-brand-background-dark border-y border-gray-200 dark:border-gray-700 py-8">
  <div class="container mx-auto px-4 max-w-5xl">
    <dl class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map((stat) => (
        <div class="flex flex-col items-center gap-1">
          <dt class="text-3xl font-bold text-brand-primary dark:text-brand-primary-dark font-heading">
            {stat.value}
          </dt>
          <dd class="text-sm text-gray-500 dark:text-brand-body-dark font-medium uppercase tracking-wide">
            {stat.label}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

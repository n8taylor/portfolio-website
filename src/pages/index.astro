---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import StatsStrip from '../components/StatsStrip.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allCaseStudies = await getCollection('case-studies');
const caseStudies = allCaseStudies.sort(
  (a: CollectionEntry<'case-studies'>, b: CollectionEntry<'case-studies'>) =>
    (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<Layout title="Nate Taylor — UX/UI Portfolio" description="Portfolio of Nate Taylor, Web UX/UI Project Manager at Utah State University. Targeting UI Designer, Visual Designer, and Interaction Designer roles.">

  <!-- Hero -->
  <HeroSection />

  <!-- Stats strip -->
  <StatsStrip />

  <!-- Selected Work -->
  <section id="work" class="container mx-auto px-4 py-20 max-w-5xl">
    <div class="mb-12 text-center">
      <p class="text-brand-accent font-semibold text-sm uppercase tracking-widest mb-2">Portfolio</p>
      <h2 class="text-4xl font-bold text-gray-900 dark:text-white">Selected Work</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {caseStudies.map((cs: CollectionEntry<'case-studies'>) => (
        <CaseStudyCard
          title={cs.data.title}
          description={cs.data.description}
          role={cs.data.role}
          tags={cs.data.tags}
          href={`/case-studies/${cs.slug}`}
          coverImage={cs.data.coverImage}
          coverColor={cs.data.coverColor}
          status={cs.data.status}
        />
      ))}
    </div>
  </section>

  <!-- About Teaser -->
  <section class="bg-white dark:bg-brand-background-dark border-t border-gray-200 dark:border-gray-700">
    <div class="container mx-auto px-4 py-20 max-w-5xl">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <!-- Branded graphic placeholder -->
        <div class="flex-shrink-0 w-40 h-40 rounded-full bg-gradient-to-br from-brand-primary to-brand-accent flex items-center justify-center shadow-lg">
          <img src="/n8-logo-solid-1.svg" alt="" class="h-20 w-auto opacity-90" aria-hidden="true" />
        </div>
        <div>
          <p class="text-brand-accent font-semibold text-sm uppercase tracking-widest mb-2">About</p>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
            Designer + Project Manager
          </h2>
          <p class="text-gray-600 dark:text-brand-body-dark leading-relaxed mb-6 max-w-lg">
            I've spent the last several years at Utah State University leading UX/UI initiatives —
            from research and wireframing to final visual design and implementation.
            I care deeply about making things usable, accessible, and beautiful.
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-2 text-brand-primary dark:text-brand-primary-dark font-semibold hover:gap-3 transition-all duration-200"
          >
            Read more about me
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer banner image -->
  <div class="w-full overflow-hidden">
    <img src="/footer-banner.png" alt="" class="w-full object-cover object-center block" />
  </div>

</Layout>
